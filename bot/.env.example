# Safe default: no external services are enabled. Copy to bot/.env.
# Start npm from bot/ so dotenv loads bot/.env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# Optional Telegram webhook settings (production setup is manual):
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# MESSAGE_WORKER_POLL_MS=2000
# There is no working in-memory job processor; Supabase is required for jobs.
